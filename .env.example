# Required: Supabase project URL, for example https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Required: Supabase anon/publishable key. This is intentionally browser-visible and is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only for authenticated image uploads to Vercel Blob from /admin/media.
# Server-only: never prefix this value with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Required for first-party anonymous page-view ingestion at /api/analytics.
# Server-only: never prefix this value with NEXT_PUBLIC_. This key never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional only for running live, destructive-safe integration tests. Do not set in Vercel.
# `npm run test:integration` creates a temporary verified test user and draft page, then deletes both.
CMS_INTEGRATION_TESTS=0

# Optional: configured in Supabase Auth for email links and OAuth redirects.
# Set to the deployed public site origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://infiniteheroes.net
