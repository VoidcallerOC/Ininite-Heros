{
  "name": "infinite-heroes-comics",
  "version": "2.0.0",
  "private": true,
  "description": "Content-managed Infinite Heroes Comics website for Vercel and Supabase.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "CMS_INTEGRATION_TESTS=1 tsx --test tests/integration/**/*.test.ts",
    "check": "node tools/validate-site.mjs && npm run typecheck && npm run test",
    "check:content": "node tools/validate-content.mjs",
    "verify": "npm run check && npm run check:content && npm run build",
    "seed:check": "tsx tools/verify-seed.ts",
    "check:browser": "node tools/browser-check.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
